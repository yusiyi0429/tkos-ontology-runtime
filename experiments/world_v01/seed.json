  "steps": [
    {
      "key": "company",
      "do": "create",
      "by": "ceo",
      "type": "Company",
      "domain": "company",
      "payload": {
        "title": "词元云集（TokenKing）",
        "blocks": {
          "identity": {
            "text": "长期愿景是建设系统性 Token 工厂；拟定的长期身份是「企业经营范式重构与 Token 运营中枢」（七月稿中待管理层确认的六个问题之一）。",
            "artifacts": [
              "https://feishu.example/docx/strategy-positioning-2026-07"
            ]
          },
          "constraint": {
            "text": "创业公司，不追求 Token 用量最大化：研发按需用模型。"
          }
        }
      },
      "note": "来源：七月总体战略定位稿 p1、p2、p10（确）；约束出自 9/23 会 02:03（确）。"
    },
    {
      "key": "strategy",
      "do": "create",
      "by": "ceo",
      "type": "Strategy",
      "domain": "company",
      "payload": {
        "title": "词元云集总体战略（存根）",
        "parent_ref": "@company",
        "blocks": {
          "choices": {
            "text": "主线是 AI 企业智能决策网络；辅线 TokenOps 只做轻量验证。",
            "artifacts": [
              "https://feishu.example/docx/strategy-positioning-2026-07"
            ]
          },
          "path": {
            "text": "到 8 月 31 日做内部灯塔；8 月 31 日到春节前做内部验证加少量外部试点；下一轮注资后扩张。"
          },
          "assumptions": {
            "text": "不能把 Token 消纳设为唯一牵引。"
          },
          "capabilities": {
            "text": "Foundry / Ontology、引擎与 TokenHub 是两条业务的共同底座。"
          },
          "responsibility_structure": {
            "text": "3 个战场：01 灯塔项目、02 Token Ops、03 002 客户。7 个能力域：02 Re-architecture、03 Method、04 Agents、05 E&O、07 TokenHub、08 Talent & Organization、09 Finance, Compliance & Operations。",
            "artifacts": [
              "https://feishu.example/docx/battlefield-map-v1"
            ]
          }
        }
      },
      "note": "来源：七月战略稿 p5–p10、战场图 V1（确；assumptions 为推断）。战略约束材料里没有，留空。"
    },
    {
      "key": "unit_eo",
      "do": "create",
      "by": "ceo",
      "type": "ResponsibilityUnit",
      "domain": "eo",
      "payload": {
        "title": "E&O",
        "unit_kind": "domain",
        "architecture_ref": "@strategy#responsibility_structure",
        "blocks": {
          "definition": {
            "text": "Engine & Ontology，战场图编号 05 的能力域：主导语义模型（本体）与 Context Runtime，主要支撑灯塔项目的 Mission 01-2、01-3、01-4。",
            "artifacts": [
              "https://feishu.example/docx/battlefield-map-v1"
            ]
          },
          "boundary": {
            "text": "业务建模不归 E&O：由 CEO 与 Method 锁定业务语义，E&O 忠实翻译成语义模型、数据承载与运行时。Activity 要不要成为对象由 E&O 自己定。",
            "artifacts": [
              "https://feishu.example/docx/tkos-business-world-framework-v01"
            ]
          },
          "constraint": {
            "text": "tkos.method/0.4、0.5 冻结不改；当前量级用 PostgreSQL 加 pgvector，不引入图数据库。"
          }
        }
      },
      "note": "来源：战场图 V1、框架稿 p4/p14/p15、方案 v0.1（确）；pgvector 一句出自 9/22 17:37 会的讨论（推）。"
    },
    {
      "key": "unit_agents",
      "do": "create",
      "by": "ceo",
      "type": "ResponsibilityUnit",
      "domain": "agents",
      "payload": {
        "title": "Agents",
        "unit_kind": "domain",
        "architecture_ref": "@strategy#responsibility_structure",
        "blocks": {
          "definition": {
            "text": "战场图编号 04 的能力域：CEO Agent、DRI Agent 与经营协同 Agent。"
          }
        }
      },
      "note": "诱饵所需的别的责任单元。来源：战场图 V1（确）。"
    },
    {
      "key": "assign_eo_dri",
      "do": "assign",
      "by": "ceo",
      "target": "unit_eo",
      "to": "eo_dri",
      "note": "真实指派时间与会议材料里没有（请你确认）；这里记播种时刻。"
    },
    {
      "key": "assign_agents_dri",
      "do": "assign",
      "by": "ceo",
      "target": "unit_agents",
      "to": "agents_dri"
    },
