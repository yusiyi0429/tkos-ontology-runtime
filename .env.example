# Configuration reference, not a ready-to-use governed deployment.
# The acceptance harness generates isolated credentials and ignores this file.
# Real deployment must provision distinct migration-owner and application roles.
POSTGRES_USER=tkos_memory
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tkos_memory

# API and Worker require the restricted application-role URL.
# Supply a separate owner URL only to the migration process.
DATABASE_URL=postgresql://tkos_memory:CHANGE_ME@127.0.0.1:5432/tkos_memory
DB_CONNECT_TIMEOUT=5

MEMORY_TENANT=local
MEMORY_ORG=local-org
VIEWER_USER_ID=00000000-0000-0000-0000-000000000000

MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MEMORY_EMBEDDING_MODEL=doubao-embedding-vision-250615
MEMORY_EMBEDDING_DIM=2048

# Required by every Clark compatibility route.
ADAPTER_AUTH=clark:CHANGE_ME

# Scoped PostgreSQL worker; dispatches effects already authorized by governed Actions.
RUNTIME_WORKER_ID=memory-worker-1
RUNTIME_WORKER_POLL_SECONDS=1
RUNTIME_TASK_LEASE_SECONDS=30
RUNTIME_TASK_RETRY_BASE_SECONDS=2
RUNTIME_TASK_RETRY_MAX_SECONDS=60
RUNTIME_TASK_MAX_ATTEMPTS=5
RUNTIME_WORKER_HEALTH_MAX_AGE_SECONDS=30

# Versioned, Object-Locked evidence storage, also used by object_store.preflight.
TKOS_OBJECT_STORE_ENDPOINT=http://minio:9000
TKOS_OBJECT_STORE_BUCKET=tkos-snapshots
TKOS_OBJECT_STORE_ACCESS_KEY=CHANGE_ME
TKOS_OBJECT_STORE_SECRET_KEY=CHANGE_ME
TKOS_OBJECT_STORE_REGION=us-east-1
TKOS_OBJECT_STORE_VERIFY_TLS=false

# Fixed external-effect destination. Requires a receiver that persistently
# deduplicates Idempotency-Key and returns the matching effect_key.
# Real receivers also need service authentication before deployment.
GOVERNED_EFFECT_URL=
# Clark narrative compatibility. Disabled until scoped credentials and policy
# have been provisioned. Model/search keys do not grant Runtime authority.
TKOS_NARRATIVE_ENABLED=0
TKOS_NARRATIVE_DOMAIN_ID=
TKOS_NARRATIVE_LEGACY_ENABLED=0
TKOS_NARRATIVE_COMPRESSION=none
TKOS_NARRATIVE_TIMEOUT_SECONDS=20
TKOS_NARRATIVE_MODEL_BASE_URL=
TKOS_NARRATIVE_MODEL_API_KEY=
TKOS_NARRATIVE_MODEL=
