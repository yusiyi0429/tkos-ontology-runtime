COMPOSE_PROJECT_NAME=tkos-ontology-runtime
TARGET_ARCH=__ARCH__
RUNTIME_HTTP_PORT=8030

RUNTIME_API_IMAGE=tkos/ontology-runtime:__RELEASE__-__ARCH__
RUNTIME_WORKER_IMAGE=tkos/ontology-worker:__RELEASE__-__ARCH__
POSTGRES_IMAGE=tkos/offline-postgres-pgvector:__RELEASE__-__ARCH__
MINIO_IMAGE=tkos/offline-minio:__RELEASE__-__ARCH__
MINIO_MC_IMAGE=tkos/offline-minio-mc:__RELEASE__-__ARCH__

POSTGRES_ADMIN_USER=tkos_runtime_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTGRES_OWNER_USER=tkos_runtime_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
POSTGRES_APP_USER=tkos_runtime_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
POSTGRES_DB=tkos_runtime

MEMORY_TENANT=CHANGE_ME_TENANT
MEMORY_ORG=CHANGE_ME_ORGANIZATION
ADAPTER_AUTH=
VIEWER_USER_ID=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIM=2048

MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_APP_POLICY=tkos-runtime-v1
MINIO_RETENTION_DAYS=30
MINIO_ARTIFACT_BUCKET=tkos-runtime-artifacts
MINIO_SNAPSHOT_BUCKET=tkos-runtime-snapshots

DB_CONNECT_TIMEOUT=5
RUNTIME_WORKER_ID=tkos-runtime-worker-1
RUNTIME_WORKER_POLL_SECONDS=1
