COMPOSE_PROJECT_NAME=tkos-world-02
TARGET_ARCH=amd64
RUNTIME_HTTP_PORT=8050

# 两个自建镜像（build_images.py 的标签 world-02-<短提交>-amd64），标签里的占位换成短提交号；
# 三个基础镜像沿用主机上离线包的 v0.5.0-amd64。
RUNTIME_API_IMAGE=tkos/ontology-runtime:world-02-__COMMIT__-amd64
RUNTIME_WORKER_IMAGE=tkos/ontology-worker:world-02-__COMMIT__-amd64
POSTGRES_IMAGE=tkos/offline-postgres-pgvector:v0.5.0-amd64
MINIO_IMAGE=tkos/offline-minio:v0.5.0-amd64
MINIO_MC_IMAGE=tkos/offline-minio-mc:v0.5.0-amd64

POSTGRES_ADMIN_USER=tkos_world02_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
POSTGRES_OWNER_USER=tkos_world02_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
POSTGRES_APP_USER=tkos_world02_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
POSTGRES_DB=tkos_world02

MEMORY_TENANT=tokenking
MEMORY_ORG=world-02
ADAPTER_AUTH=
VIEWER_USER_ID=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIM=2048

MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_APP_POLICY=tkos-world02-v1
MINIO_RETENTION_DAYS=30
MINIO_SNAPSHOT_BUCKET=tkos-world02-snapshots

DB_CONNECT_TIMEOUT=5
RUNTIME_WORKER_ID=tkos-world02-worker-1
RUNTIME_WORKER_POLL_SECONDS=1
