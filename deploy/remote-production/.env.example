COMPOSE_PROJECT_NAME=tkos-runtime-prod
RUNTIME_HTTP_PORT=8030

RUNTIME_API_IMAGE=tkos/ontology-runtime:release-id-amd64
RUNTIME_WORKER_IMAGE=tkos/ontology-worker:release-id-amd64
POSTGRES_IMAGE=tkos/vendor-pgvector:pg17-f193b9c8-amd64
MINIO_IMAGE=tkos/vendor-minio:3f97c565-amd64
MINIO_MC_IMAGE=tkos/vendor-minio-mc:4ccb0c74-amd64

POSTGRES_ADMIN_USER=tkos_runtime_admin
POSTGRES_ADMIN_PASSWORD=generated-on-target
POSTGRES_OWNER_USER=tkos_runtime_owner
POSTGRES_OWNER_PASSWORD=generated-on-target
POSTGRES_APP_USER=tkos_runtime_app
POSTGRES_APP_PASSWORD=generated-on-target
POSTGRES_DB=tkos_runtime

MEMORY_TENANT=copied-from-authoritative-source
MEMORY_ORG=copied-from-authoritative-source
ADAPTER_AUTH=copied-from-authoritative-source
VIEWER_USER_ID=copied-from-authoritative-source
# Mounted as the docker secret private/embedding-api-key; this entry stays for
# configure.py bookkeeping and is not passed into the runtime container.
MEMORY_EMBEDDING_API_KEY=copied-from-authoritative-source
MEMORY_EMBEDDING_BASE_URL=copied-from-authoritative-source
MEMORY_EMBEDDING_MODEL=copied-from-authoritative-source
MEMORY_EMBEDDING_DIM=2048

TKOS_NARRATIVE_COMPRESSION=none
TKOS_NARRATIVE_TIMEOUT_SECONDS=20
TKOS_NARRATIVE_SCOPE_ID=generated-on-target
TKOS_NARRATIVE_DOMAIN_ID=generated-on-target
TKOS_NARRATIVE_PRINCIPAL_ID=generated-on-target
TKOS_NARRATIVE_ASSIGNMENT_ID=generated-on-target
TKOS_NARRATIVE_CREDENTIAL_ID=generated-on-target
TKOS_NARRATIVE_POLICY_ID=generated-on-target
TKOS_NARRATIVE_POLICY_REVISION_ID=generated-on-target

MINIO_ROOT_USER=generated-on-target
MINIO_ROOT_PASSWORD=generated-on-target
MINIO_APP_ACCESS_KEY=generated-on-target
MINIO_APP_SECRET_KEY=generated-on-target
MINIO_APP_POLICY=tkos-runtime-prod-v1
MINIO_SNAPSHOT_BUCKET=tkos-runtime-snapshots
MINIO_SNAPSHOT_RETENTION=30d

DB_CONNECT_TIMEOUT=5
# Bounded pool per runtime process.  Keep the sum across API and Worker below
# the server's max_connections.  0 disables pooling and restores one
# connection per request, which is the rollback switch for this change.
GOVERNED_POOL_MAX_SIZE=10
GOVERNED_POOL_TIMEOUT_SECONDS=10
# Transaction-local lock and statement limits (ms); 0 disables.  Waiting past
# them returns a retryable 503 instead of holding a pooled connection.
GOVERNED_LOCK_TIMEOUT_MS=5000
GOVERNED_STATEMENT_TIMEOUT_MS=30000
# Statement counters for the performance baseline (db_admin.py statements).
PG_STAT_STATEMENTS_MAX=5000
RUNTIME_WORKER_ID=tkos-runtime-prod-worker-1
RUNTIME_WORKER_POLL_SECONDS=1
