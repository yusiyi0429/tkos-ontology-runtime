      "key": "task_data",
      "do": "create",
      "by": "owner",
      "type": "Task",
      "domain": "eo",
      "payload": {
        "title": "数据环境准备",
        "parent_ref": "@mission",
        "blocks": {
          "definition": {
            "text": "与业务建模并行，准备并搭建数据环境：数据库随一二级分类重构，出计划；对应方案里的「数据承载」。",
            "artifacts": [
              "https://feishu.example/docx/tkos-world-plan-v01"
            ]
          },
          "constraint": {
            "text": "method 0.4、0.5 冻结，不迁移、不建桥；迁移只追加；播种经治理路径且可清。",
            "artifacts": [
              "https://repo.example/tkos-ontology-runtime/blob/d5b158e/docs/contracts/tkos-world-0.1.md"
