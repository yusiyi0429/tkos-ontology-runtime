      "do": "create",
      "by": "owner",
      "type": "Task",
      "domain": "eo",
      "payload": {
        "title": "TKOS 业务建模方案设计",
        "parent_ref": "@mission",
        "blocks": {
          "definition": {
            "text": "按 CEO 对齐稿的口径设计本体：4 个责任范围 × 7 类经营语义、约 20 个一级对象。",
            "artifacts": [
              "https://feishu.example/docx/tkos-ontology-v07-ceo-alignment"
            ]
