{
  "format": "tkos-world-02-experiment-b-script/0.1",
  "id": "smoke",
  "title": "冒烟：两条线按同一份脚本推到 Mission 关闭",
  "notes": "预置的冒烟脚本，内容是合成的：按 b_lines.json 的段把「天枢 × 本体 0.2 试用」走完一遍，覆盖指派某一段、开始、Agent 在某一段上写进展（带写入声明）、交付、退回（带理由）、重开、验收、在某一段上提出/路由/承接/处置问题、状态刷新。试用期间由 E&O 把真实 scope 里这场 Mission 的记录转写成同一格式的脚本回放。",
  "steps": [
    {"do": "start", "by": "eo-owner", "mission": true, "note": "Mission 开始"},

    {"do": "start", "by": "eo-owner", "task": "task_trial_integration"},
    {"do": "start", "by": "eo-ic", "segment": "integration"},
    {"do": "start", "by": "eo-owner", "segment": "delegation_setup"},
    {"do": "progress", "by": "eo-ic", "segment": "integration", "text": "按接口清单跑通取对象、列对象与外部引用查找，代记写入还差撤回。"},
    {"do": "deliver", "by": "eo-ic", "segment": "integration", "text": "联调用例全部跑通。"},
    {"do": "reject", "by": "eo-owner", "segment": "integration", "text": "联调用例里没有代记的撤回，补上再交。"},
    {"do": "deliver", "by": "eo-ic", "segment": "integration", "text": "补上代记撤回的用例，全部跑通。"},
    {"do": "accept", "by": "eo-owner", "segment": "integration"},
    {"do": "deliver", "by": "eo-owner", "segment": "delegation_setup", "text": "三条委托已登记。"},
    {"do": "accept", "by": "eo-owner", "segment": "delegation_setup"},
    {"do": "deliver", "by": "eo-owner", "task": "task_trial_integration"},
    {"do": "accept", "by": "eo-owner", "task": "task_trial_integration"},

    {"do": "start", "by": "eo-ic", "task": "task_trial_week"},
    {"do": "assign", "by": "eo-ic", "segment": "weekly_snapshot", "to": "exec-agent", "note": "每周快照交给执行 Agent"},
    {"do": "start", "by": "exec-agent", "segment": "weekly_snapshot"},
    {"do": "progress", "by": "exec-agent", "segment": "weekly_snapshot", "text": "10/12 周快照草稿：各任务卡的本周进展已汇总。"},
    {"do": "deliver", "by": "exec-agent", "segment": "weekly_snapshot", "text": "10/12 周快照。",
     "declaration": {"trigger": "每周一汇总任务卡进展", "acceptor": "eo-ic"}},
    {"do": "reject", "by": "eo-ic", "segment": "weekly_snapshot", "text": "快照没有引用来源事件，补上再交。"},
    {"do": "deliver", "by": "exec-agent", "segment": "weekly_snapshot", "text": "补上来源事件的 10/12 周快照。",
     "declaration": {"trigger": "按退回理由补齐", "acceptor": "eo-ic"}},
    {"do": "accept", "by": "eo-ic", "segment": "weekly_snapshot"},
    {"do": "start", "by": "eo-ic", "segment": "issue_flow"},
    {"do": "raise_issue", "by": "eo-coagent", "segment": "issue_flow", "issue": "delegation_scope",
     "question": "天枢的委托要不要覆盖公司域？", "text": "试用中天枢要代 CEO 记公司域的门，委托目前只覆盖 E&O 域。"},
    {"do": "route_issue", "by": "eo-coagent", "issue": "delegation_scope", "to": "eo-owner"},
    {"do": "own_issue", "by": "eo-owner", "issue": "delegation_scope"},
    {"do": "dispose_issue", "by": "eo-owner", "issue": "delegation_scope", "disposition": "current_layer_action",
     "text": "试用只登记 E&O 域的委托，公司域的门由 CEO 本人记。"},
    {"do": "deliver", "by": "eo-ic", "segment": "issue_flow", "text": "试用周的问题都已处置。"},
    {"do": "reopen", "by": "eo-ic", "segment": "weekly_snapshot", "text": "10/15 的周快照漏了问题的处置，重开补上。"},
    {"do": "progress", "by": "exec-agent", "segment": "weekly_snapshot", "text": "补上委托范围问题的处置结论。"},
    {"do": "deliver", "by": "exec-agent", "segment": "weekly_snapshot", "text": "补上处置结论的周快照。",
     "declaration": {"trigger": "按重开理由补齐", "acceptor": "eo-ic"}},
    {"do": "accept", "by": "eo-ic", "segment": "weekly_snapshot"},
    {"do": "accept", "by": "eo-ic", "segment": "issue_flow"},
    {"do": "deliver", "by": "eo-ic", "task": "task_trial_week"},
    {"do": "accept", "by": "eo-owner", "task": "task_trial_week"},

    {"do": "start", "by": "eo-owner", "task": "task_trial_acceptance"},
    {"do": "start", "by": "eo-owner", "segment": "acceptance_run"},
    {"do": "refresh", "by": "eo-owner", "segment": "acceptance_run", "text": "10/16 联调验收：按验收条件逐项核对，全部通过。"},
    {"do": "deliver", "by": "eo-owner", "segment": "acceptance_run", "text": "联调验收结论已记下。"},
    {"do": "accept", "by": "eo-owner", "segment": "acceptance_run"},
    {"do": "deliver", "by": "eo-owner", "task": "task_trial_acceptance"},
    {"do": "accept", "by": "eo-owner", "task": "task_trial_acceptance"},

    {"do": "refresh", "by": "eo-owner", "mission": true, "text": "三个 Task 全部关闭，10 月 16 日天枢联调验收通过。"},
    {"do": "deliver", "by": "eo-owner", "mission": true, "text": "天枢 × 本体 0.2 试用完成。"},
    {"do": "accept", "by": "eo-dri", "mission": true}
  ]
}
