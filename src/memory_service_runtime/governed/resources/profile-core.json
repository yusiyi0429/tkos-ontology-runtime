  "rules": {
    "composition": {
      "scope": "one_company_current_required_member_set",
      "quorum": "all_current_required_signers_same_manifest",
      "activation": "atomic_whole_set",
      "partial_activation_permitted": false,
      "signature_inheritance_across_manifests": false,
      "single_active_formation_per_period": true,
      "cross_round_capacity_reservations_checked": true,
      "same_business_content_different_revision_is_new_input": true,
      "formal_submission_or_binding_change": "new_composition_review_and_all_resign",
      "local_unshared_draft_change": "does_not_change_formal_input_set",
      "unrelated_auth_epoch_change": "recheck_relevant_authority_not_auto_resign",
      "required_binding_changed_or_expired": "reject_new_activation",
      "required_judgments": [
        "coverage",
        "coherence",
        "feasibility",
        "tradeoff"
      ],
      "unresolved_hard_conflict": "reject_even_if_all_signed",
      "llm_judgment_can_override_hard_constraint": false,
      "complete_member_set_derived_by_server": true,
      "manifest_excludes": [
        "confirmation_progress",
        "mutable_object_cas_versions",
        "receipt_ids"
      ],
      "manifest_hash_scheme": "server_generated_versioned_scheme_defined_by_main_contract_not_JCS_claim",
      "required_signer_rule": "current_CEO_plus_current_accountable_DRI_for_each_current_required_area",
      "distinct_natural_persons_required": true,
      "member_add_remove_supported_by_same_profile": true,
      "member_change_effect": "amend_round_member_set_new_composition_review_all_current_required_resign",
      "judgment_display_aliases": {
        "company_feasibility": "feasibility"
      }
    },
    "version_and_draft": {
      "stable_object_id_separate_from_revision_and_cas": true,
      "unshared_working_draft_overwrite_permitted": true,
      "freeze_on": [
        "shared_reference",
        "dri_submission",
        "composition_review",
        "formal_confirmation",
        "delivery_submission"
      ],
      "historical_confirmations_append_only": true,
      "shared_reference_implies_commitment": false,
      "old_receipt_implies_current_execute_permission": false
    },
    "responsibility_and_acceptance": {
      "area_dri_may_hold_mission_accountability_in_fixture": true,
      "dri_and_ic_same_natural_person_permitted": false,
      "what_handshake_parties": [
        "named_current_accountable_dri",
        "named_current_executing_ic"
      ],
      "both_sign_same_content_revision": true,
      "execution_authority_release_by": "named_current_accountable_dri",
      "last_signature_implicitly_releases_execution": false,
      "work_receipt_is": "acknowledgement_of_exact_dispatched_work_baseline_not_new_parallel_what_commitment",
      "acceptor_mode": "independent_third_person",
      "acceptor_cannot_be": [
        "executing_ic",
        "submission_actual_author",
        "submission_declared_coauthor",
        "fixture_dri"
      ],
      "agent_may_sign_or_accept": false,
      "handover_rewrites_historical_authors_or_signers": false,
      "future_actions_require_current_responsibility_binding": true,
      "three_results_independent": [
        "delivery_acceptance",
        "company_result_assessment",
        "feedback_disposition"
      ]
    },
    "what_how": {
      "what_fields": [
        "result_statement",
        "success_criteria",
        "responsibility_bindings",
        "hard_deadline",
        "hard_budget_units",
        "external_dependency_refs",
        "external_promises",
        "scope_exclusions"
      ],
      "how_fields_allowed_within_what": [
        "internal_step_order",
        "internal_work_method",
        "nonbinding_internal_milestones",
        "local_tool_choice"
      ],
      "material_change_threshold": "any_change_to_structured_what_field_requires_formal_revision",
      "unknown_classification": "review_required_not_assume_how",
      "plan_revision_can_change_acceptance_standard": false,
      "changed_what_can_reuse_old_handshake": false
    },
    "authority_and_visibility": {
      "historical_fact_deleted_on_revocation": false,
      "read_and_replay_use_current_rights": true,
      "cross_area_read_grants_are_union_by_default": false,
      "all_composition_signers_read_full_published_manifest": true,
      "private_evidence_shared_by_merge_or_summary_automatically": false,
      "explicit_source_publication_grant_required": true,
      "legacy_endpoint_can_bypass_profile": false
    }
  },
