      "do": "create",
      "by": "ceo",
      "type": "LongTermGoal",
      "domain": "company",
      "payload": {
        "title": "春节前核心业务第一次被真实证明",
        "scope": "company",
        "horizon": "2027 年春节前",
        "parent_ref": "@company",
        "blocks": {
          "outcome": {
            "text": "跑通「Re-architecture 进入客户 → TKOS 持续经营」这条主线，形成可复制的产品、交付与商业模式；同时跑通 TokenHub / TokenOps 的商业闭环。",
            "artifacts": [
              "https://feishu.example/docx/battlefield-map-v1"
            ]
          }
        }
      },
      "note": "来源：战场图 V1 顶栏（确）；衡量材料里没有，留空。"
    },
